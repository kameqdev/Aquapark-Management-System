NODE_ENV=development # one of [ development, test, production ]

# Parameters used by the compose.yaml and backend (assembled in env.ts)
POSTGRES_HOST=localhost # localhost, postgres, or a cloud database host
POSTGRES_PORT=5432
POSTGRES_DB=ams_db
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=ams_pass

# Optional override (e.g., for an external cloud database / CI).
# When uncommented, env.ts will use this URL instead of the POSTGRES_* variables above
# DATABASE_URL=postgresql://ams_user:ams_pass@localhost:5432/ams_db